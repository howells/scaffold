    ".": {
      "anti-slop(no-runtime-typeof)": 4,
      "anti-slop(no-unknown-parameters)": 2,
      "anti-slop(require-safety-comment-for-type-assertion)": 3,
      "eslint(arrow-body-style)": 2,
