{
  "name": "scaffold",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "source": "fumadocs-mdx",
    "lint": "howells-check src next.config.mjs source.config.ts",
    "lint:fix": "howells-fix src next.config.mjs source.config.ts",
    "format": "howells-oxfmt --write AGENTS.md README.md package.json pnpm-workspace.yaml next.config.mjs source.config.ts postcss.config.mjs tsconfig.json src",
    "typecheck": "pnpm run source && tsc --noEmit",
    "sync:skill": "node scripts/sync-skill.ts",
    "generate:principles": "node scripts/generate-principles.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm generate:principles --check && pnpm sync:skill --check"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "clsx": "^2.1.1",
    "fumadocs-core": "16.11.1",
    "fumadocs-mdx": "15.1.0",
    "fumadocs-ui": "16.11.1",
    "lucide-react": "1.23.0",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "4.3.2"
  },
  "devDependencies": {
    "@howells/lint": "1.0.0",
    "@howells/typescript-config": "0.1.6",
    "@types/mdx": "2.0.14",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "packageManager": "pnpm@11.10.0"
}
