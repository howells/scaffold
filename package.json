{
  "name": "scaffold",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "deploy:prod": "node scripts/build-source-deploy.ts",
    "deploy:prod:build": "vercel build --prod --scope danielhowells",
    "deploy:prod:capture": "pnpm generate:source && pnpm deploy:prod:stamp && node scripts/build-source.ts capture --repo . --include .source --build-config .vercel/project.json",
    "deploy:prod:linux": "sh scripts/deploy-prod-linux.sh",
    "deploy:prod:publish": "node scripts/publish-vercel-prebuilt.mjs",
    "deploy:prod:pull": "vercel pull --yes --environment=production --scope danielhowells",
    "deploy:prod:stamp": "node scripts/stamp-build.mjs",
    "deploy:prod:verify": "node scripts/check-vercel-prebuilt.mjs",
    "dev": "next dev",
    "generate:principles": "node scripts/generate-principles.ts",
    "generate:source": "fumadocs-mdx",
    "lint": "pnpm generate:source && howells-check src next.config.mjs source.config.ts scripts/build-source*.ts scripts/build-source*.mts",
    "lint:fix": "pnpm generate:source && howells-fix src next.config.mjs source.config.ts scripts/build-source*.ts scripts/build-source*.mts",
    "prepare": "howells-husky",
    "start": "next start",
    "sync:skill": "node scripts/sync-skill.ts",
    "test": "node --test scripts/build-source*.test.mts && node scripts/check-docs-integrity.ts && pnpm generate:principles --check && pnpm sync:skill --check",
    "typecheck": "pnpm generate:source && tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "cn": "^0.3.0",
    "fumadocs-core": "16.15.1",
    "fumadocs-mdx": "15.3.1",
    "fumadocs-ui": "16.15.1",
    "lucide-react": "1.34.0",
    "next": "16.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@howells/husky": "^0.2.5",
    "@howells/lint": "^3.5.1",
    "@howells/typescript-config": "0.1.8",
    "@types/mdx": "2.0.14",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "lint-staged": "^17.5.1",
    "shadcn": "4.19.0",
    "typescript": "7.0.2",
    "zod": "4.6.5"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,jsonc,css,md,mdx}": "howells-oxfmt --write"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.10.0"
}
